# ==============================================================================
# Cloudflare Worker Local Development Variables Example (.dev.vars)
# Copy this file to worker/.dev.vars when testing locally with `wrangler dev`.
# In production, configure secrets via `wrangler secret put <NAME>`.
# ==============================================================================

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: Secret token to authenticate incoming Telegram Webhook updates (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Optional: Secret header to protect POST /telegram/init-commands endpoint (X-Init-Command-Secret)
INIT_COMMAND_SECRET=
