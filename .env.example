# ==============================================================================
# NVIDIA Free Endpoint Monitor - Root Environment Configuration Example
# Copy this file to .env for local development / testing.
# ==============================================================================

# Required for Telegram change notifications (used in src/monitor.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Reddit API credentials for community ecosystem signal collection (src/catalog/ecosystem/reddit.py)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Optional: HTTP/HTTPS proxy configuration for local network environments
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
